# Copy to .env and fill in. Never commit .env.

# Telethon userbot (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Your own notifier bot (@BotFather) and your chat id
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# IC Markets MetaTrader 5 (broker: mt5). Use a DEMO login for MODE=paper.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=ICMarketsSC-Demo
# Optional: full path to terminal64.exe if it is not the default install
MT5_PATH=

# OANDA v20 (only for broker: oanda)
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=
OANDA_LIVE_TOKEN=
OANDA_LIVE_ACCOUNT_ID=

# Must be exactly "yes" for MODE=live to start
LIVE_CONFIRM=no
